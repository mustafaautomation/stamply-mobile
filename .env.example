# Optional. Leave both unset to run the seeded demo with no backend.
# Use the anon key only. Do not put a service-role key in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Needed only for a real Expo push token in a dev or production build.
EXPO_PUBLIC_EAS_PROJECT_ID=
